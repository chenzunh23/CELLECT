    "fwhm_clipping": null,
    "intervals": {
      "4": "0 <= r <= r10",
      "3": "r10 < r <= r35",
      "2": "r35 < r <= r60",
      "1": "r60 < r <= r70",
      "0": "r > r70, except forced nearest-center level 4"
    },
    "fallback": {
      "trigger": "no output pixel center lies inside r10",
      "action": "assign level 4 to exactly one nearest output pixel center",
      "nearest_xy": "floor(source_xy + 0.5)",
      "tie_break": "choose the larger coordinate on each tied axis",
      "retain_multiple_natural_level4_pixels": true,
      "allow_other_levels_to_be_empty": true
    },
    "validated_domain": "source and its full support inside an unmasked image; image edges and invalid-pixel training weights are handled separately by the caller",
    "overlapping_sources": "use existing pixelwise maximum of ordinal levels when integrated; not a change to instance identity"
  },
  "training_notes": [
    "Level 4 can contain multiple pixels; a level-4 pixel is not independently a separate object.",
