      "photutils": "3.0.0"
    }
  },
  "rasterization": {
    "distance": "Euclidean distance from source center to output pixel center",
    "coordinates": "zero-based x,y; integer coordinates are pixel centers; boundaries at half-integers",
    "radius_pixels": "radius_arcsec / output_WCS_pixel_scale_arcsec",
    "reference_pixel_scale_arcsec": 0.03,
