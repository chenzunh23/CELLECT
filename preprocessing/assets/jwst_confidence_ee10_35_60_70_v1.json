    }
  ],
  "measurement": {
    "center": "geometric array center: ((nx-1)/2, (ny-1)/2), zero-based x,y",
    "pixel_scale": "PIXELSCL in the selected extension, arcsec/pixel",
    "aperture": "photutils.aperture.CircularAperture.to_mask(method=\"exact\")",
    "root_solver": "scipy.optimize.brentq",
    "xtol_arcsec": 1e-11,
